# ===== Pegar en Railway -> Variables -> RAW Editor =====

# --- Telegram (OBLIGATORIAS: rellena las dos) ---
TELEGRAM_TOKEN=PEGA_AQUI_TOKEN_DE_BOTFATHER
TELEGRAM_CHAT_ID=PEGA_AQUI_TU_CHAT_ID

# --- Escáner: TODAS las monedas de BingX ---
TIMEFRAME=15m
STRICTNESS=standard
TOP_N=0
MIN_QUOTE_VOL=0
SYMBOLS=
EXCLUDE=
WARMUP_BARS=500
WORKERS=6
REQ_INTERVAL=0.11
CLOSE_DELAY_S=3
UNIVERSE_REFRESH_H=6

# --- Señales ---
SL_BUFFER_ATR=0.25
MIN_RR=1.5
MAX_SL_PCT=8
COOLDOWN_BARS=8
ALERT_EVENTS=spring,utad,sos,sow
HEARTBEAT_H=12
LOG_LEVEL=INFO

# --- BingX (solo si AUTO_TRADE=1) ---
BINGX_API_KEY=
BINGX_API_SECRET=
POSITION_MODE=hedge

# --- Ejecución automática (0 = solo señales) ---
AUTO_TRADE=0
RISK_PCT=1
LEVERAGE=5
MARGIN_TYPE=ISOLATED
MAX_POSITIONS=3
TP1_FRAC=0.5
